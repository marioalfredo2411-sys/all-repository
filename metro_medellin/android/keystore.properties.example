# Plantilla para firmar la app de release.
#
#  1. Genera el keystore (una sola vez, y guárdalo: sin él no puedes publicar
#     actualizaciones de la app en Google Play):
#
#     keytool -genkey -v -keystore metromed-release.jks -keyalg RSA \
#             -keysize 2048 -validity 10000 -alias metromed
#
#  2. Copia este archivo a  android/keystore.properties  y rellena los valores.
#  3. `npm run android:bundle` producirá un .aab firmado.
#
# android/keystore.properties está en .gitignore. No subas ni el .jks ni las
# contraseñas al repositorio.

storeFile=metromed-release.jks
storePassword=CAMBIA_ESTO
keyAlias=metromed
keyPassword=CAMBIA_ESTO
