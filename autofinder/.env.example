# Copia este archivo como .env y rellena la clave.
# .env está en .gitignore: NUNCA lo subas al repositorio.

# Clave de la API de Anthropic. La lee el proxy del servidor
# (server/anthropic-proxy.mjs); nunca llega al navegador.
# Sin esta variable la app arranca en MODO DEMO con datos de ejemplo.
ANTHROPIC_API_KEY=

# Solo para APK / IPA: URL absoluta del backend donde corre el proxy,
# porque dentro de la app nativa una ruta relativa apunta al bundle local.
# Ej: https://api.tudominio.com
# En la web déjala vacía para usar la ruta relativa /api/messages.
VITE_API_BASE=
