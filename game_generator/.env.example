# === API key de Anthropic (Claude) ===
# SOLO se usa en el servidor (Netlify Function / middleware de Vite).
# NUNCA llega al navegador. Consíguela en https://console.anthropic.com/settings/keys
#
#   Desarrollo local : copia este archivo a .env.local y pega tu key
#   Producción        : Netlify → Site settings → Environment variables
#
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional
VITE_ENVIRONMENT=production
